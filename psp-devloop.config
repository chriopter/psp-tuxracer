# psp-devloop profile for this project.
#
#   https://github.com/chriopter/psp-devloop
#
# Run with:  /path/to/psp-devloop/devloop psp-devloop.config
#
# Exit codes: 0 pass, 77 skipped on purpose, anything else a failure that stops
# the loop. Success comes from the benchmark result file, never from emulator
# output. A green emulator stage is not proof that the game runs on a PSP; only
# stage 03 answers that.

PSP_PROJECT_DIR="$PSP_DEVLOOP_CONFIG_DIR"


# STAGES

DEBUG_COMMAND='python3 tools/test-etr-numerics.py && python3 tools/test-psp-save.py && python3 tools/test-psp-music.py && python3 tools/test-release.py && ./build-extremetuxracer.sh'

PPSSPP_TEST_COMMAND='"$PSP_DEVLOOP_ROOT/lib/run-project" ppsspp'
JPCSP_TEST_COMMAND='"$PSP_DEVLOOP_ROOT/lib/run-project" jpcsp'

HARDWARE_TEST_COMMAND=''
HARDWARE_RECOVERY_COMMAND=''


# EMULATOR SETTINGS
#
# The emulator is asked for a fixed benchmark run by dropping a request file
# next to the save data; the game writes benchmark-result.json when it reaches
# the end of the course.

ms0_dir="$PSP_PROJECT_DIR/state/extremetuxracer/config/ppsspp/PSP"
game_dir="$ms0_dir/GAME/ExtremeTuxRacer"
built_eboot="$PSP_PROJECT_DIR/ports/extremetuxracer/psp/EBOOT.PBP"
benchmark_file="$game_dir/config/benchmark"

result_file="$game_dir/config/benchmark-result.json"

ppsspp_command='TUXRACER_BACKGROUND_AUDIO=0 ./start-extremetuxracer-background.sh'
ppsspp_timeout=120

jpcsp_ms0="$ms0_dir"
jpcsp_eboot="$game_dir/EBOOT.PBP"
jpcsp_timeout=600


# HOOKS

# Restage whenever the build is newer than what was staged, so either emulator
# works on its own without repeating the image conversion in the same loop.
stage() {
  if [[ ! -f "$game_dir/EBOOT.PBP" || "$built_eboot" -nt "$game_dir/EBOOT.PBP" ]]; then
    python3 "$PSP_PROJECT_DIR/tools/stage-extremetuxracer.py"
  fi

  mkdir -p "$game_dir/config"
  printf '600 frozen_river\n' >"$benchmark_file"
}

check() {
  python3 -m json.tool "$result_file" >/dev/null
}

# Leaving the request file behind would make every later manual launch run the
# benchmark instead of the game.
cleanup() {
  rm -f "$benchmark_file"
}
